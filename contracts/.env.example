# Somnia testnet (Shannon)
# Source: https://docs.somnia.network/developer/network-info
SOMNIA_TESTNET_RPC=https://api.infra.testnet.somnia.network/
SOMNIA_TESTNET_CHAIN_ID=50312
SOMNIA_TESTNET_EXPLORER=https://shannon-explorer.somnia.network/
SOMNIA_TESTNET_FAUCET=https://testnet.somnia.network/

# IAgentRequester (Somnia testnet)
# Source: https://docs.somnia.network/agents/invoking-agents/from-solidity
SOMNIA_AGENT_REQUESTER=0x037Bb9C718F3f7fe5eCBDB0b600D607b52706776

# Agent IDs the resolver + signal agent call. Placeholders — set to the real
# Somnia testnet agent IDs once registered. Deploy.s.sol falls back to 1/2/3.
SEER_JSON_AGENT_ID=1
SEER_LLM_AGENT_ID=2
SEER_MARKETABILITY_AGENT_ID=3

# Reactor that calls factory.onMarketProposed (a Somnia ContractEvent
# subscription). Defaults to the deployer EOA so markets can be cranked by hand
# until the subscription is registered.
SEER_REACTOR=

# Deployer wallet (DO NOT commit the real .env)
PRIVATE_KEY=0x

# Optional: explorer API key for verification
SOMNIA_EXPLORER_KEY=
